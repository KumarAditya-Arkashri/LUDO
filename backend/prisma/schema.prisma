generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PLAYER
  ADMIN
}

enum WalletType {
  MAIN
  WINNING
  REFERRAL
  BONUS
  SYSTEM
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  GAME_ENTRY
  GAME_WIN
  REFERRAL_REWARD
  ADMIN_CREDIT
  ADMIN_DEBIT
  REFUND
}

model User {
  id           String         @id @default(uuid())
  mobile       String         @unique
  name         String
  passwordHash String
  avatarUrl    String?
  role         Role           @default(PLAYER)
  referralCode String         @unique @default(uuid())
  kycVerified  Boolean        @default(false)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  
  // Fraud Prevention
  deviceId     String?
  upiId        String?
  bankAccount  String?

  // Referral
  referredById String?
  referredBy   User?          @relation("ReferralHistory", fields: [referredById], references: [id])
  referredUsers User[]        @relation("ReferralHistory")

  tokens       RefreshToken[]
  ledgers      Ledger[]
  deposits     Deposit[]      @relation("UserDeposits")
  verifiedDeposits Deposit[]  @relation("AdminVerifier")
  withdrawals  Withdrawal[]   @relation("UserWithdrawals")
  verifiedWithdrawals Withdrawal[] @relation("AdminWithdrawalVerifier")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  expiresAt DateTime
  isRevoked Boolean  @default(false)
  createdAt DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?  // nullable for failed logins
  action    String
  details   String?
  ipAddress String?
  createdAt DateTime @default(now())
}

model Ledger {
  id              String          @id @default(uuid())
  userId          String?
  user            User?           @relation(fields: [userId], references: [id])
  walletType      WalletType
  transactionType TransactionType
  amount          Decimal
  referenceId     String?
  description     String?
  createdAt       DateTime        @default(now())

  @@index([userId, walletType])
  @@unique([userId, referenceId, transactionType])
}

model ReferralConfig {
  id               String     @id @default(uuid())
  isEnabled        Boolean    @default(true)
  rewardAmount     Decimal    @default(10)
  rewardWalletType WalletType @default(BONUS)
  activationRule   String     @default("ON_REGISTER") // e.g. ON_REGISTER, ON_KYC, FIRST_DEPOSIT
  minWithdrawal    Decimal    @default(50)
  updatedAt        DateTime   @updatedAt
}

enum DepositStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

model Deposit {
  id            String        @id @default(uuid())
  userId        String
  user          User          @relation("UserDeposits", fields: [userId], references: [id])
  amount        Decimal
  utr           String?       @unique
  screenshotUrl String?
  status        DepositStatus @default(PENDING)
  rejectReason  String?
  
  verifiedAt    DateTime?
  verifiedById  String?
  verifiedBy    User?         @relation("AdminVerifier", fields: [verifiedById], references: [id])
  
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([userId])
  @@index([status])
}

enum WithdrawalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model Withdrawal {
  id            String          @id @default(uuid())
  userId        String
  user          User            @relation("UserWithdrawals", fields: [userId], references: [id])
  walletType    WalletType      @default(WINNING)
  amount        Decimal
  status        WithdrawalStatus @default(PENDING)
  upiId         String?
  bankDetails   String?
  utr           String?         @unique
  adminNotes    String?
  rejectReason  String?
  
  verifiedAt    DateTime?
  verifiedById  String?
  verifiedBy    User?           @relation("AdminWithdrawalVerifier", fields: [verifiedById], references: [id])
  
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([userId])
  @@index([status])
}
