PORT=3000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB_NAME
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Example: ALLOWED_ORIGINS=https://ludoarena.in,https://www.ludoarena.in
# Leave empty in development — localhost origins are added automatically.
ALLOWED_ORIGINS=

# ─── Environment ──────────────────────────────────────────────────────────────
# Set to "production" on your server. Controls CORS + dev defaults.
NODE_ENV=development

# ─── Swagger ──────────────────────────────────────────────────────────────────
# Set to "false" in production to hide API documentation from public.
SWAGGER_ENABLED=true
